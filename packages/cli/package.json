{
  "name": "@oxygen/cli",
  "version": "0.1.0",
  "description": "CLI tool for Oxygen specification management",
  "type": "module",
  "bin": {
    "oxygen": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "lint:check": "eslint .",
    "lint:write": "eslint . --fix",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@oxygen/core": "workspace:*",
    "chalk": "^4.1.2",
    "commander": "^11.0.0",
    "inquirer": "^9.2.0",
    "ora": "^5.4.1"
  },
  "devDependencies": {
    "@oxygen/eslint-config": "workspace:*",
    "@oxygen/prettier-config": "workspace:*",
    "@types/inquirer": "^9.0.0",
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.6.0"
  }
}
