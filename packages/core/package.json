{
  "name": "@oxygen/core",
  "version": "0.1.0",
  "description": "Core library for Oxygen specification management",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "lint:check": "eslint .",
    "lint:write": "eslint . --fix",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "simple-git": "^3.19.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@oxygen/eslint-config": "workspace:*",
    "@oxygen/prettier-config": "workspace:*",
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.6.0"
  }
}
